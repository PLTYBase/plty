# Copy this file to .env and fill in the values. .env is gitignored (never commit it).

# Private key of the deployer wallet (with 0x prefix). Use a disposable launch-only wallet.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Basescan (Etherscan) API key, used to verify the contract source. Free at https://basescan.org
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
